{
	"schemaVersion": 1,
	"id": "zeropvpthings",
	"version": "${version}",
	"name": "Zero's PVP Things",
	"description": "Client-side PvP toolkit: item highlighting, inventory scaler, momentum bar, 1500% gamma, gap damage tracker, custom crosshairs (with Marvel Rivals code import) and a CustomHUD-style text HUD.",
	"authors": [
		"ZeroGreay"
	],
	"contact": {
		"sources": "https://github.com/ZeroGreay/Zero-sPVPThings"
	},
	"license": "MIT",
	"icon": "assets/zeropvpthings/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.zero.pvpthings.ZeroPvpThings"
		],
		"modmenu": [
			"dev.zero.pvpthings.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"zeropvpthings.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
